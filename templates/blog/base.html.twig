{% extends "common/base.html.twig" %}

{% block layout %}layout layout-paper{% endblock %}

{% block body %}
    <div class="container-fluid theme theme-paper">
        <div class="row theme-header">
            <div class="theme-header-logo"></div>
        </div>

        <div class="row theme-body">
            <div class="col-md-12">
                <div class="row theme-menu">
                    <div class="col-md-12">
                        {% set currentRoute = app.request.attributes.get('_route') %}
                        {% set activeRoute = currentRoute %}
                        {% if currentRoute == 'blog_article' and entity is defined and entity %}
                            {% set activeRoute = entity.article.type.blogListRouteName %}
                        {% endif %}
                        {{ include('blog/partials/menu.html.twig', {
                            pageLinks: page_links(page.page.ref, entity|default(null)),
                            currentRoute: currentRoute,
                            activeRoute: activeRoute,
                        }) }}
                    </div>
                </div>

                <div class="row theme-content{% if showLinks is defined %} show_links{% endif %}">
                    <div class="col-md-12 theme-content-top">
                        {% block content %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row theme-footer">
            <div class="col-md-12">
                {%- include "blog/partials/footer.html.twig" -%}
            </div>
        </div>
    </div>
{% endblock %}
