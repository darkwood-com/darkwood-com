{% extends "common/base.html.twig" %}

{% block layout %}layout layout-darkwood{% endblock %}

{% block head_extra %}
    <link rel="preload" as="image" type="image/webp" href="{{ asset('common/images/components/theme-dark/site/header/darkwood.webp') }}" fetchpriority="high">
{% endblock %}

{% block body %}
    <div class="container-fluid theme theme-darkwood">
        <div class="row theme-header">
            <div class="theme-header-logo">
                <picture>
                    <source type="image/webp" srcset="{{ asset('common/images/components/theme-dark/site/header/darkwood.webp') }}">
                    <img
                        src="{{ asset('common/images/components/theme-dark/site/header/darkwood.png') }}"
                        width="1800"
                        height="250"
                        alt="Darkwood"
                        decoding="async"
                        fetchpriority="high"
                    >
                </picture>
            </div>
        </div>

        <div class="row theme-body">
            <div class="col-md-12">
                <div class="row theme-menu">
                    <div class="col-md-12">
                    {{ include('darkwood/partials/menu.html.twig', {
                        pageLinks: page_links(page.page.ref, entity|default(null)),
                        currentRoute: app.request.attributes.get('_route'),
                        currentMode: app.request.query.get('mode'),
                    }) }}
                    </div>
                </div>

                <div class="row theme-content{% if showLinks is defined %} show_links{% endif %}">
                    <div class="col-md-12 theme-content-top">
                        {% block content %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row theme-footer">
            <div class="col-md-12">
                {%- include "darkwood/partials/footer.html.twig" -%}
            </div>
        </div>
    </div>
{% endblock %}
